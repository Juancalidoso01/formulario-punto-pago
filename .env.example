# Copia el JSON de la cuenta de servicio (Google Cloud) en UNA sola línea.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ID de la hoja: https://docs.google.com/spreadsheets/d/<ESTE_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Pestaña y rango (fila 1 = cabeceras, ver comentario en app/api/leads/route.ts)
GOOGLE_SHEETS_RANGE=Leads!A:Z
