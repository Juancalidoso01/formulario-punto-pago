# =============================================================================
# Google Sheets — salida de leads del formulario
# =============================================================================
#
# PASO 1 — Google Cloud
#   • Proyecto en https://console.cloud.google.com
#   • APIs habilitadas: Google Sheets API
#   • Cuenta de servicio → Crear clave → JSON
#
# PASO 2 — Pegar JSON en UNA sola línea (minificado):
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"tu-cuenta@proyecto.iam.gserviceaccount.com"}
#
# PASO 3 — Hoja de destino
#   • Cree una hoja en Google Sheets
#   • Pestaña: Leads (nombre exacto)
#   • Fila 1: ejecute  node scripts/verify-google-sheets.mjs --init-headers
#   • Comparta la hoja con client_email del JSON (rol Editor)
#
# ID en la URL: https://docs.google.com/spreadsheets/d/<ESTE_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# 21 columnas (A–U). Debe existir la pestaña Leads.
GOOGLE_SHEETS_RANGE=Leads!A:U

# Verificar en local:  node scripts/verify-google-sheets.mjs
# En Vercel: Project → Settings → Environment Variables (Production + Preview)
#
# =============================================================================
# Google Drive — fotos, aviso y firma de cada lead
# =============================================================================
#
# IMPORTANTE: use una UNIDAD COMPARTIDA (Shared Drive), no «Mi unidad».
# Las cuentas de servicio no tienen espacio en carpetas personales.
#
# 1. Google Workspace → drive.google.com → Unidades compartidas → Nueva
# 2. Miembros: agregue client_email del JSON a la UNIDAD COMPARTIDA (Colaborador de contenido)
#    No basta compartir solo una carpeta de «Mi unidad» por enlace.
# 3. Dentro de la unidad, cree una carpeta (ej. «Afiliaciones»)
# 4. Google Cloud: habilite Google Drive API
# 5. ID de esa carpeta (URL …/folders/<ESTE_ID>, sin ?usp=)
GOOGLE_DRIVE_FOLDER_ID=
#
# Verificar: npm run drive:verify
# Sin esta variable, solo se guardan nombres de archivo en Sheets (como antes).
#
# =============================================================================

# Geoapify: autocomplete de direcciones (servidor).
GEOAPIFY_API_KEY=

# Opcional: clave expuesta en el cliente si no hay GEOAPIFY_API_KEY en servidor.
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# =============================================================================
# Slack — notificación al completar el formulario
# =============================================================================
#
# 1. En Slack: Apps → Incoming Webhooks → Add to Slack → elija el canal (#ventas, etc.)
# 2. Copie la URL (https://hooks.slack.com/services/...)
# 3. En Vercel: SLACK_WEBHOOK_URL (Production + Preview)
#
# Canal general: kioscos, agente, corporativo.
SLACK_WEBHOOK_URL=

# Canal / grupo solo Cuotas (recomendado: webhook distinto → #cuotas-leads o similar).
# Si solo configura este, los leads de Cuotas van aquí; el resto usa SLACK_WEBHOOK_URL.
SLACK_WEBHOOK_URL_CUOTAS=

# Prueba: npm run slack:verify  |  npm run slack:verify:cuotas
